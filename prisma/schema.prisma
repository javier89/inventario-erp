generator client {
  provider = "prisma-client-js"
  seed     = "node ../seed/seed.js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id_categoria Int         @id @default(autoincrement())
  nombre       String?     @db.VarChar(100)
  descripcion  String?     @db.Text
  Productos    Productos[]
}

model Compra {
  id_compra    Int           @id @default(autoincrement())
  fecha_compra DateTime?     @default(now()) @db.DateTime(0)
  total_compra Float?        @db.Float
  num_factura  String?       @db.VarChar(100)
  form_pago    String?       @db.VarChar(100)
  id_proveedor Int?
  estado       Compra_estado @default(ABIERTA)
  Proveedor    Proveedor?    @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: Cascade, map: "fk_proveedor_compra")
  Movimiento   Movimiento[]

  @@index([id_proveedor], map: "fk_proveedor_compra")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Detalle_Compra {
  id_detalle      Int       @id @default(autoincrement())
  id_compra       Int
  id_producto     Int
  cantidad        Int
  precio_producto Decimal   @db.Decimal(10, 2)
  estado_compra   String?   @db.VarChar(100)
  costo_total     Decimal?  @db.Decimal(10, 2)
  Productos       Productos @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade, map: "fk_producto_detalle")

  @@index([id_compra], map: "fk_compra_detalle")
  @@index([id_producto], map: "fk_producto_detalle")
}

model Empleado {
  id_empleado Int     @id @default(autoincrement())
  nombre      String? @db.VarChar(100)
  cargo       String? @db.VarChar(50)
  activo      Boolean @default(true)
}

model HistorialPrecio {
  id_historial    Int       @id @default(autoincrement())
  id_producto     Int
  precio_producto Decimal   @db.Decimal(5, 2)
  precio_anterior Decimal?  @db.Decimal(10, 2)
  tipo_precio     String?   @db.VarChar(20)
  fecha           DateTime? @default(now()) @db.DateTime(0)
  Productos       Productos @relation(fields: [id_producto], references: [id_producto], map: "fk_historial_producto")

  @@index([id_producto], map: "fk_historial_producto")
}

model Motivo {
  id_motivo   Int     @id @default(autoincrement())
  nombre      String? @db.VarChar(100)
  descripcion String? @db.VarChar(100)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Movimiento {
  id_movimiento    Int                         @id @default(autoincrement())
  fecha_movimiento DateTime?                   @default(now()) @db.DateTime(0)
  tipo_movimiento  Movimiento_tipo_movimiento?
  cantidad         Int
  stock_anterior   Int
  stock_nuevo      Int
  id_producto      Int
  id_empleado      Int?
  id_compra        Int?
  Productos        Productos                   @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade, onUpdate: NoAction, map: "fk_mov_producto")
  Compra           Compra?                     @relation(fields: [id_compra], references: [id_compra], onDelete: NoAction, onUpdate: NoAction, map: "fk_movimiento_compra")

  @@index([id_producto], map: "fk_mov_producto")
  @@index([id_compra], map: "fk_movimiento_compra")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Productos {
  id_producto     Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(100)
  id_categoria    Int?
  id_proveedor    Int?
  codigo_barras   String?           @db.VarChar(100)
  stock           Int               @default(0)
  sku             String            @unique(map: "sku")
  unidad_medida   String?           @db.VarChar(80)
  ubicacion       String?           @db.VarChar(100)
  activo          Boolean?          @default(true)
  Detalle_Compra  Detalle_Compra[]
  Detalle_Salida  Detalle_Salida[]
  HistorialPrecio HistorialPrecio[]
  Movimiento      Movimiento[]
  Categoria       Categoria?        @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade, map: "fk_categoria_producto")
  Proveedor       Proveedor?        @relation(fields: [id_proveedor], references: [id_proveedor], map: "fk_proveedor_producto")

  @@index([id_categoria], map: "fk_categoria_producto")
  @@index([id_proveedor], map: "fk_proveedor_producto")
}

model Proveedor {
  id_proveedor    Int         @id @default(autoincrement())
  nombre          String?     @db.VarChar(100)
  telefono        String?     @db.VarChar(20)
  direccion       String?     @db.VarChar(200)
  email           String?     @db.VarChar(100)
  rfc             String?     @unique(map: "rfc") @db.VarChar(20)
  contacto_ventas String?     @db.VarChar(100)
  estado          String?     @db.VarChar(100)
  Compra          Compra[]
  Productos       Productos[]
}

model Rol {
  id_rol       Int       @id @default(autoincrement())
  descriptcion String?   @db.VarChar(100)
  nombre       String?   @unique @db.VarChar(100)
  Usuario      Usuario[]
}

model Usuario {
  id_usuario    Int     @id @default(autoincrement())
  usuario       String? @unique @db.VarChar(50)
  nombre        String?
  password_hash String? @db.VarChar(256)
  estado        String? @default("Activo") @db.VarChar(50)
  id_rol        Int
  Rol           Rol     @relation(fields: [id_rol], references: [id_rol], map: "fk_usuario_rol")

  @@index([id_rol], map: "fk_usuario_rol")
}

model Detalle_Salida {
  id_detalle  Int        @id @default(autoincrement())
  id_salida   Int?
  id_producto Int?
  cantidad    Int?
  Salida      Salida?    @relation(fields: [id_salida], references: [id_salida], onDelete: NoAction, onUpdate: NoAction, map: "Detalle_Salida_ibfk_1")
  Productos   Productos? @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction, map: "Detalle_Salida_ibfk_2")

  @@index([id_producto], map: "id_producto")
  @@index([id_salida], map: "id_salida")
}

model Salida {
  id_salida      Int              @id @default(autoincrement())
  fecha_salida   DateTime?        @default(now()) @db.DateTime(0)
  motivo         String?          @db.VarChar(100)
  id_empleado    Int?
  Detalle_Salida Detalle_Salida[]
}

enum Movimiento_tipo_movimiento {
  ENTRADA
  SALIDA
  AJUSTES
  CANCELADA
}

enum Compra_estado {
  ABIERTA
  CERRADA
  CANCELADA
}
